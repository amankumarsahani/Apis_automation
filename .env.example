# GitHub Personal Access Token (required for API access & private repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets Configuration
# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
# Name of the Google Sheet to save results (will be created if not exists)
GOOGLE_SHEET_NAME=API_Keys_Scan_Results

# Optional: Share the sheet with this email automatically
SHARE_WITH_EMAIL=your-email@gmail.com

# Email Alerts (Gmail SMTP)
# Generate app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_EMAIL=alerts-recipient@gmail.com

# Discovery Settings
DISCOVERY_MAX_REPOS=50
# Comma-separated org names to scan members of (optional)
DISCOVERY_ORGS=

# Scan Configuration
MAX_REPOS=100
SCAN_COMMIT_HISTORY=true
MAX_COMMITS_PER_REPO=500
CLONE_DEPTH=50
